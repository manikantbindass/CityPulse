{
  "variable": {
    "name": {
      "type": "string"
    },
    "vpc_id": {
      "type": "string"
    }
  },
  "resource": {
    "aws_security_group": {
      "alb": {
        "name_prefix": "${var.name}-alb-",
        "vpc_id": "${var.vpc_id}"
      },
      "web": {
        "name_prefix": "${var.name}-web-",
        "vpc_id": "${var.vpc_id}"
      },
      "api": {
        "name_prefix": "${var.name}-api-",
        "vpc_id": "${var.vpc_id}"
      },
      "ai": {
        "name_prefix": "${var.name}-ai-",
        "vpc_id": "${var.vpc_id}"
      }
    },
    "aws_vpc_security_group_ingress_rule": {
      "https": {
        "security_group_id": "${aws_security_group.alb.id}",
        "cidr_ipv4": "0.0.0.0/0",
        "ip_protocol": "tcp",
        "from_port": 443,
        "to_port": 443
      },
      "redirect": {
        "security_group_id": "${aws_security_group.alb.id}",
        "cidr_ipv4": "0.0.0.0/0",
        "ip_protocol": "tcp",
        "from_port": 80,
        "to_port": 80
      },
      "web": {
        "security_group_id": "${aws_security_group.web.id}",
        "referenced_security_group_id": "${aws_security_group.alb.id}",
        "ip_protocol": "tcp",
        "from_port": 3000,
        "to_port": 3000
      },
      "api": {
        "security_group_id": "${aws_security_group.api.id}",
        "referenced_security_group_id": "${aws_security_group.web.id}",
        "ip_protocol": "tcp",
        "from_port": 8080,
        "to_port": 8080
      },
      "ai": {
        "security_group_id": "${aws_security_group.ai.id}",
        "referenced_security_group_id": "${aws_security_group.api.id}",
        "ip_protocol": "tcp",
        "from_port": 8000,
        "to_port": 8000
      }
    },
    "aws_vpc_security_group_egress_rule": {
      "alb": {
        "security_group_id": "${aws_security_group.alb.id}",
        "cidr_ipv4": "0.0.0.0/0",
        "ip_protocol": "-1"
      },
      "web": {
        "security_group_id": "${aws_security_group.web.id}",
        "cidr_ipv4": "0.0.0.0/0",
        "ip_protocol": "-1"
      },
      "api": {
        "security_group_id": "${aws_security_group.api.id}",
        "cidr_ipv4": "0.0.0.0/0",
        "ip_protocol": "-1"
      },
      "ai": {
        "security_group_id": "${aws_security_group.ai.id}",
        "cidr_ipv4": "0.0.0.0/0",
        "ip_protocol": "-1"
      }
    }
  },
  "output": {
    "alb": {
      "value": "${aws_security_group.alb.id}"
    },
    "web": {
      "value": "${aws_security_group.web.id}"
    },
    "api": {
      "value": "${aws_security_group.api.id}"
    },
    "ai": {
      "value": "${aws_security_group.ai.id}"
    }
  }
}
