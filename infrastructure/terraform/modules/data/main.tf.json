{
  "variable": {
    "name": {
      "type": "string"
    },
    "vpc_id": {
      "type": "string"
    },
    "api_security_group": {
      "type": "string"
    },
    "web_security_group": {
      "type": "string"
    },
    "ai_security_group": {
      "type": "string"
    },
    "postgres_version": {
      "type": "string"
    },
    "bucket_name": {
      "type": "string"
    },
    "subnets": {
      "type": "list(string)"
    },
    "redis_auth_token": {
      "type": "string",
      "sensitive": true,
      "validation": {
        "condition": "${can(regex(\"^[a-zA-Z0-9!&#$^<>-]{32,128}$\", var.redis_auth_token))}",
        "error_message": "Use 32-128 ElastiCache AUTH-compatible random characters."
      }
    },
    "enable_queue": {
      "type": "bool",
      "default": false
    }
  },
  "resource": {
    "aws_security_group": {
      "db": {
        "name_prefix": "${var.name}-db-",
        "vpc_id": "${var.vpc_id}",
        "egress": []
      },
      "redis": {
        "name_prefix": "${var.name}-redis-",
        "vpc_id": "${var.vpc_id}",
        "egress": []
      },
      "efs": {
        "name_prefix": "${var.name}-efs-",
        "vpc_id": "${var.vpc_id}",
        "egress": []
      }
    },
    "aws_vpc_security_group_ingress_rule": {
      "db": {
        "security_group_id": "${aws_security_group.db.id}",
        "referenced_security_group_id": "${var.api_security_group}",
        "ip_protocol": "tcp",
        "from_port": 5432,
        "to_port": 5432
      },
      "redis_api": {
        "security_group_id": "${aws_security_group.redis.id}",
        "referenced_security_group_id": "${var.api_security_group}",
        "ip_protocol": "tcp",
        "from_port": 6379,
        "to_port": 6379
      },
      "redis_web": {
        "security_group_id": "${aws_security_group.redis.id}",
        "referenced_security_group_id": "${var.web_security_group}",
        "ip_protocol": "tcp",
        "from_port": 6379,
        "to_port": 6379
      },
      "efs": {
        "security_group_id": "${aws_security_group.efs.id}",
        "referenced_security_group_id": "${var.ai_security_group}",
        "ip_protocol": "tcp",
        "from_port": 2049,
        "to_port": 2049
      }
    },
    "aws_db_subnet_group": {
      "this": {
        "name": "${var.name}",
        "subnet_ids": "${var.subnets}"
      }
    },
    "aws_db_parameter_group": {
      "this": {
        "name_prefix": "${var.name}-",
        "family": "postgres17",
        "parameter": [
          {
            "name": "rds.force_ssl",
            "value": "1",
            "apply_method": "pending-reboot"
          }
        ]
      }
    },
    "aws_db_instance": {
      "this": {
        "identifier": "${var.name}",
        "engine": "postgres",
        "engine_version": "${var.postgres_version}",
        "instance_class": "db.t4g.small",
        "db_name": "citypulse",
        "username": "citypulse_owner",
        "manage_master_user_password": true,
        "allocated_storage": 30,
        "max_allocated_storage": 200,
        "storage_type": "gp3",
        "storage_encrypted": true,
        "multi_az": true,
        "publicly_accessible": false,
        "db_subnet_group_name": "${aws_db_subnet_group.this.name}",
        "parameter_group_name": "${aws_db_parameter_group.this.name}",
        "vpc_security_group_ids": ["${aws_security_group.db.id}"],
        "backup_retention_period": 14,
        "copy_tags_to_snapshot": true,
        "delete_automated_backups": false,
        "deletion_protection": true,
        "skip_final_snapshot": false,
        "final_snapshot_identifier": "${var.name}-final",
        "enabled_cloudwatch_logs_exports": ["postgresql"],
        "auto_minor_version_upgrade": true,
        "apply_immediately": false
      }
    },
    "aws_elasticache_subnet_group": {
      "this": {
        "name": "${var.name}",
        "subnet_ids": "${var.subnets}"
      }
    },
    "aws_elasticache_replication_group": {
      "this": {
        "replication_group_id": "${var.name}",
        "description": "Private CityPulse session/cache store",
        "engine": "redis",
        "engine_version": "7.1",
        "node_type": "cache.t4g.small",
        "num_cache_clusters": 2,
        "automatic_failover_enabled": true,
        "multi_az_enabled": true,
        "at_rest_encryption_enabled": true,
        "transit_encryption_enabled": true,
        "auth_token": "${var.redis_auth_token}",
        "auth_token_update_strategy": "ROTATE",
        "subnet_group_name": "${aws_elasticache_subnet_group.this.name}",
        "security_group_ids": ["${aws_security_group.redis.id}"],
        "snapshot_retention_limit": 7
      }
    },
    "aws_s3_bucket": {
      "datasets": {
        "bucket": "${var.bucket_name}",
        "force_destroy": false
      }
    },
    "aws_s3_bucket_public_access_block": {
      "this": {
        "bucket": "${aws_s3_bucket.datasets.id}",
        "block_public_acls": true,
        "block_public_policy": true,
        "ignore_public_acls": true,
        "restrict_public_buckets": true
      }
    },
    "aws_s3_bucket_versioning": {
      "this": {
        "bucket": "${aws_s3_bucket.datasets.id}",
        "versioning_configuration": {
          "status": "Enabled"
        }
      }
    },
    "aws_s3_bucket_server_side_encryption_configuration": {
      "this": {
        "bucket": "${aws_s3_bucket.datasets.id}",
        "rule": {
          "apply_server_side_encryption_by_default": {
            "sse_algorithm": "AES256"
          }
        }
      }
    },
    "aws_s3_bucket_policy": {
      "tls": {
        "bucket": "${aws_s3_bucket.datasets.id}",
        "policy": "{\"Version\": \"2012-10-17\", \"Statement\": [{\"Effect\": \"Deny\", \"Principal\": \"*\", \"Action\": \"s3:*\", \"Resource\": [\"${aws_s3_bucket.datasets.arn}\", \"${aws_s3_bucket.datasets.arn}/*\"], \"Condition\": {\"Bool\": {\"aws:SecureTransport\": \"false\"}}}]}"
      }
    },
    "aws_s3_bucket_lifecycle_configuration": {
      "this": {
        "bucket": "${aws_s3_bucket.datasets.id}",
        "rule": [
          {
            "id": "retention",
            "status": "Enabled",
            "filter": {
              "prefix": ""
            },
            "abort_incomplete_multipart_upload": {
              "days_after_initiation": 7
            },
            "noncurrent_version_expiration": {
              "noncurrent_days": 90
            }
          }
        ]
      }
    },
    "aws_efs_file_system": {
      "this": {
        "encrypted": true,
        "tags": {
          "Name": "${var.name}-ai"
        }
      }
    },
    "aws_efs_mount_target": {
      "this": {
        "count": 2,
        "file_system_id": "${aws_efs_file_system.this.id}",
        "subnet_id": "${var.subnets[count.index]}",
        "security_groups": ["${aws_security_group.efs.id}"]
      }
    },
    "aws_efs_access_point": {
      "ai": {
        "file_system_id": "${aws_efs_file_system.this.id}",
        "posix_user": {
          "uid": 10001,
          "gid": 10001
        },
        "root_directory": {
          "path": "/citypulse-ai",
          "creation_info": {
            "owner_uid": 10001,
            "owner_gid": 10001,
            "permissions": "0700"
          }
        }
      }
    },
    "aws_efs_backup_policy": {
      "this": {
        "file_system_id": "${aws_efs_file_system.this.id}",
        "backup_policy": {
          "status": "ENABLED"
        }
      }
    },
    "aws_sqs_queue": {
      "dlq": {
        "count": "${var.enable_queue ? 1 : 0}",
        "name": "${var.name}-dlq",
        "sqs_managed_sse_enabled": true,
        "message_retention_seconds": 1209600
      },
      "jobs": {
        "count": "${var.enable_queue ? 1 : 0}",
        "name": "${var.name}-jobs",
        "sqs_managed_sse_enabled": true,
        "visibility_timeout_seconds": 300,
        "redrive_policy": "${jsonencode({deadLetterTargetArn=aws_sqs_queue.dlq[0].arn,maxReceiveCount=3})}"
      }
    },
    "aws_efs_file_system_policy": {
      "this": {
        "file_system_id": "${aws_efs_file_system.this.id}",
        "policy": "{\"Version\": \"2012-10-17\", \"Statement\": [{\"Effect\": \"Deny\", \"Principal\": \"*\", \"Action\": \"elasticfilesystem:Client*\", \"Resource\": \"${aws_efs_file_system.this.arn}\", \"Condition\": {\"Bool\": {\"aws:SecureTransport\": \"false\"}}}, {\"Effect\": \"Deny\", \"Principal\": \"*\", \"Action\": \"elasticfilesystem:Client*\", \"Resource\": \"${aws_efs_file_system.this.arn}\", \"Condition\": {\"ArnNotEquals\": {\"aws:PrincipalArn\": \"arn:aws:iam::${data.aws_caller_identity.this.account_id}:role/${var.name}-ai-task\"}}}]}"
      }
    }
  },
  "output": {
    "db_endpoint": {
      "value": "${aws_db_instance.this.address}"
    },
    "db_master_secret_arn": {
      "value": "${aws_db_instance.this.master_user_secret[0].secret_arn}"
    },
    "redis_endpoint": {
      "value": "${aws_elasticache_replication_group.this.primary_endpoint_address}"
    },
    "efs_id": {
      "value": "${aws_efs_file_system.this.id}"
    },
    "efs_access_point": {
      "value": "${aws_efs_access_point.ai.id}"
    },
    "bucket_arn": {
      "value": "${aws_s3_bucket.datasets.arn}"
    },
    "security_posture": {
      "value": {
        "encrypted": "${aws_db_instance.this.storage_encrypted}",
        "public": "${aws_db_instance.this.publicly_accessible}",
        "backups": "${aws_db_instance.this.backup_retention_period}",
        "redis_tls": "${aws_elasticache_replication_group.this.transit_encryption_enabled}"
      }
    }
  },
  "data": {
    "aws_caller_identity": {
      "this": {}
    }
  }
}
