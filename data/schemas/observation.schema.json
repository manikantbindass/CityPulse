{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CityPulse observation interchange v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "cityId",
    "zoneId",
    "sourceId",
    "externalId",
    "kind",
    "commodity",
    "quantity",
    "unit",
    "observedAt",
    "periodEnd"
  ],
  "properties": {
    "cityId": {
      "type": "string",
      "format": "uuid"
    },
    "zoneId": {
      "type": "string",
      "format": "uuid"
    },
    "businessId": {
      "type": ["string", "null"],
      "format": "uuid"
    },
    "sourceId": {
      "type": "string",
      "format": "uuid"
    },
    "externalId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "kind": {
      "enum": ["supply", "demand"]
    },
    "commodity": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "quantity": {
      "type": "number",
      "minimum": 0
    },
    "unit": {
      "enum": ["count", "kg", "litre", "kwh", "trip"]
    },
    "observedAt": {
      "type": "string",
      "format": "date-time"
    },
    "periodEnd": {
      "type": "string",
      "format": "date-time"
    },
    "longitude": {
      "type": "number",
      "minimum": -180,
      "maximum": 180
    },
    "latitude": {
      "type": "number",
      "minimum": -90,
      "maximum": 90
    },
    "timezone": {
      "type": "string"
    },
    "currency": {
      "type": "string",
      "pattern": "^[A-Z]{3}$"
    },
    "dataMode": {
      "enum": ["synthetic", "historical", "live"]
    },
    "capacity": {
      "type": "number",
      "minimum": 0
    }
  }
}
