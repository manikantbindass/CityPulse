{
  "name": "@citypulse/blockchain",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "hardhat compile",
    "test": "hardhat test",
    "node": "hardhat node --hostname 127.0.0.1",
    "deploy:local": "hardhat run scripts/deploy-verification.ts --network localhost",
    "demo:local": "hardhat run scripts/local-demo.ts --network localhost",
    "deploy:testnet": "hardhat run scripts/deploy-verification.ts --network testnet",
    "verify:report": "node scripts/verify-report.ts",
    "lint": "solhint \"contracts/**/*.sol\"",
    "demo:ephemeral": "node scripts/run-ephemeral.mjs"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-ethers": "^4.2.1",
    "@nomicfoundation/hardhat-node-test-runner": "^3.1.2",
    "ethers": "^6.17.0",
    "hardhat": "3.21.1",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "@openzeppelin/contracts": "^5.6.1"
  }
}
