# Copy to .env, then replace every placeholder. Never commit .env.
POSTGRES_DB=citypulse
POSTGRES_USER=citypulse
POSTGRES_PASSWORD=replace-with-a-long-random-local-password
REDIS_PASSWORD=replace-with-another-long-random-local-password
# At least 32 characters. Used only with the explicitly enabled local profile.
LOCAL_API_TOKEN=replace-with-a-random-token-of-at-least-32-characters
WEB_PORT=3000
API_PORT=8080
AI_PORT=8000
# Host-side development; Compose sets its own internal service URLs.
DATABASE_URL=jdbc:postgresql://localhost:5432/citypulse
REDIS_HOST=localhost
REDIS_PORT=6379
AI_BASE_URL=http://localhost:8000
# Set to a real issuer before using the default (non-local) Spring profile.
OIDC_ISSUER_URI=

OIDC_AUDIENCE=citypulse-api
AI_SERVICE_TOKEN=
