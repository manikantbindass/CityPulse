# Copy to .env, then replace every placeholder. Never commit .env.
POSTGRES_DB=citypulse
POSTGRES_USER=citypulse
POSTGRES_PASSWORD=replace-with-a-long-random-local-password
REDIS_PASSWORD=replace-with-another-long-random-local-password
# At least 32 characters. Used only with the explicitly enabled local profile.
LOCAL_API_TOKEN=replace-with-a-random-token-of-at-least-32-characters
WEB_PORT=3000
API_PORT=8080
AI_PORT=8000
# Host-side development; Compose sets its own internal service URLs.
DATABASE_URL=jdbc:postgresql://localhost:5432/citypulse
REDIS_HOST=localhost
REDIS_PORT=6379
AI_BASE_URL=http://localhost:8000
# Set to a real issuer before using the default (non-local) Spring profile.
OIDC_ISSUER_URI=

OIDC_AUDIENCE=citypulse-api
# Optional separate service credential: set AI_SERVICE_TOKEN only when configured in both Java and AI.

# Optional read-only backend verification, configured only after a real deployment.
BLOCKCHAIN_RPC_URL=
BLOCKCHAIN_CHAIN_ID=31337
ATTESTATION_CONTRACT_ADDRESS=
ATTESTATION_EVENT_TOPIC=
ATTESTATION_CONTRACT_VERSION=1.0.0
# Optional testnet signer: set only in an ignored shell/environment source.
TESTNET_RPC_URL=
TESTNET_PRIVATE_KEY=
CONTRACT_ADMIN_ADDRESS=

# PulseAI: optional external provider disabled by default (no paid requests).
PULSEAI_LOCAL_PREVIEW=false
PULSEAI_PROVIDER=disabled
PULSEAI_PROVIDER_URL=https://api.openai.com/v1
PULSEAI_MODEL=
PULSEAI_API_KEY=
# Must cover BOTH input and output prices; verify with provider before enabling.
PULSEAI_MAX_USD_PER_MILLION_TOKENS=

# Explicit local synthetic/manual-only solver; never grants tenant data access.
DECISION_LOCAL_PREVIEW=false

# Separate application DB role; migration credentials remain owner-only.
DATABASE_USER=citypulse_app
DATABASE_PASSWORD=replace-with-distinct-runtime-database-password
FLYWAY_ENABLED=true
# Browser OIDC: HTTPS origin, confidential authorization-code client, PKCE.
WEB_ORIGIN=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_SCOPES=openid registry:read data:read analytics:read
# Optional exact IdP assurance claim; require in access AND ID tokens when set.
OIDC_REQUIRED_ACR=
SESSION_REDIS_URL=
SESSION_REDIS_ALLOW_LOCAL=false
# Base64-encoded random 32-byte key; rotation invalidates existing sessions.
SESSION_ENCRYPTION_KEY=
